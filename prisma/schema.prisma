generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model XeroxOrder {
  id              String   @id @default(cuid())
  customerName    String
  phoneNumber     String
  address         String
  distance        Float
  deliveryCharge  Float
  documentUrl     String
  status          OrderStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}
