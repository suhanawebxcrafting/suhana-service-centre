generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model XeroxOrder {
  id              String   @id @default(cuid())
  customerName    String
  phoneNumber     String
  address         String
  distance        Float
  deliveryCharge  Float
  documentUrl     String
  status          OrderStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

model Blog {
  id          String    @id @default(cuid())
  title       String
  excerpt     String
  content     String
  category    String
  image       String?
  author      String    @default("Suhana Team")
  isPublished Boolean   @default(true)
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  service     String
  rating      Int      @default(5)
  feedback    String
  image       String?
  isFeatured  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  service     String?
  message     String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceCustomization {
  id               String   @id @default(cuid())
  serviceId        Int      @unique
  iconOverride     String?
  imageOverride    String?
  dummyImageOverride String?
  imageAltText     String?
  dummyImageAltText String?
  updatedAt        DateTime @updatedAt
}

model VideoCard {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  thumbnailUrl String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id          String   @id @default(cuid())
  title       String
  imageUrl    String
  fileUrl     String?  // For PDF or other documents
  pageImages  String?  // JSON array of page image URLs for multi-page PDFs
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
}
